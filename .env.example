# Скопируйте в .env и заполните значения.
# Серверный ключ Static API Яндекс.Карт. Старое имя
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY тоже поддерживается для совместимости.
YANDEX_MAPS_API_KEY=

# Серверный адрес приёма заявок. POST JSON, ответ 2xx означает приём.
# Без адреса формы сохраняют данные и показывают сообщение о недоступности.
REQUESTS_WEBHOOK_URL=
# Необязательный Bearer-токен сервиса; не передаётся в браузер.
REQUESTS_WEBHOOK_TOKEN=
